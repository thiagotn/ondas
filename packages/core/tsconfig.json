{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    /**
     * `lib` sem DOM de propósito: `document`, `window` e `localStorage` precisam
     * continuar sendo erro de compilação aqui, para que `core` siga reusável no
     * Expo. Os tipos de Node cobrem os globais que são padrão nas duas
     * plataformas (fetch, AbortController, timers).
     */
    "lib": ["ES2022"],
    "types": ["vitest/globals", "node"]
  },
  "include": ["src"]
}
