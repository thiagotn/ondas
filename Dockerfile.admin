# syntax=docker/dockerfile:1

# A imagem do PAINEL DE ADMIN (`packages/admin`). Separada da PWA de propósito:
# é outro host, outro público, e nada dela entra no que o visitante baixa.

# ── build ─────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /src
RUN corepack enable

# Manifests primeiro, e os TRÊS pacotes: o `--frozen-lockfile` confere o
# workspace inteiro, mesmo que só um seja construído aqui.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY packages/web/package.json packages/web/
COPY packages/admin/package.json packages/admin/
RUN pnpm install --frozen-lockfile

# Só o que o painel usa: o core (tokens de tema, formatadores) e ele mesmo. O
# código da PWA não é copiado.
COPY packages/core/ packages/core/
COPY packages/admin/ packages/admin/
RUN pnpm --filter @ondas/admin build

# ── runtime: nginx servindo o estático, non-root (padrão do homelab) ───────────
FROM nginx:stable-alpine
COPY packages/admin/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder --chown=nginx:nginx /src/packages/admin/dist /usr/share/nginx/html
RUN mkdir -p /var/cache/nginx /var/run \
 && chown -R nginx:nginx /var/cache/nginx /var/run /usr/share/nginx/html \
 && touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
